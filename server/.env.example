# Copy to .env and replace every placeholder. Never commit the real .env.

MONGO_URI=
# Use at least 32 random characters.
JWT_SECRET=
EMAIL_USER=
EMAIL_PASS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional deployment settings
PORT=5000
CLIENT_URL=http://localhost:5173
JWT_EXPIRES_IN=1d
TRUST_PROXY=1
NODE_ENV=production
# Browser session cookies. Use `none` only when client/API are on different
# sites, and only over HTTPS (Secure is enforced in production).
COOKIE_SAME_SITE=lax
COOKIE_SECURE=true
# Off by default: browser clients authenticate only through the httpOnly cookie.
AUTH_RETURN_TOKEN=false
# Local development only: skips email delivery and returns the generated OTP
# to the client. server.js refuses to start with this enabled in production.
DEV_EXPOSE_OTP=false

# Optional rate-limit overrides
API_RATE_LIMIT=600
AUTH_RATE_LIMIT=30
# OTP issuance is additionally capped per account in code (10 per rolling 24h).

# Required only by `npm run seed`; use a strong, unique password
SEED_ADMIN_EMAIL=
SEED_ADMIN_USERNAME=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=