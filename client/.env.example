# --- Client configuration (.env) ---
# Copy this file to .env and adjust only VITE_API_URL for non-local environments.

# The base URL of the API. Vite exposes only variables prefixed with VITE_.
# During local dev this is not needed (it defaults to http://localhost:5000/api).
# For production, set it to your deployed API origin, e.g. https://api.dentalink.example/api
VITE_API_URL=http://localhost:5000/api
